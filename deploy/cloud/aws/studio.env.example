# Copy to .env on the EC2 host. Never commit the populated file.
STUDIO_DOMAIN=studio.example.com

# Generate a random value with: openssl rand -base64 32
ALPHAMOTION_ACCESS_TOKEN=replace-with-a-long-random-demo-token
ALPHAMOTION_ACCESS_MAX_DEVICES=3
ALPHAMOTION_ACCESS_SESSION_DAYS=30
ALPHAMOTION_COOKIE_SECURE=1

# Private Space id and a read-only Hugging Face token. Browser clients never
# receive this token.
ALPHAMOTION_GENMO_SPACE=your-hf-user/alphamotion-genmo
ALPHAMOTION_GENMO_TOKEN=hf_replace_me
ALPHAMOTION_GENMO_TIMEOUT_S=900
